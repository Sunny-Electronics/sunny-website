# Public website RFQ submit
# Sends quote-list popup submissions to Sunny assignees.
RESEND_API_KEY=
RFQ_FROM_EMAIL=
RFQ_ASSIGNEE_EMAILS=web@sunnykr.com

# Dedicated SunnyKR AI bridge (server-side only)
# Production accepts only https://bridge.sunnykr.com/sunny/chat.
# Never reuse another project's bridge URL, token, or environment variables.
SUNNY_AI_BRIDGE_URL=https://bridge.sunnykr.com/sunny/chat
SUNNY_AI_BRIDGE_TOKEN=
