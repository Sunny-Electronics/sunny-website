# Core
DATABASE_URL=

# Admin review API
# Required before /api/admin/* endpoints will return data.
ADMIN_API_TOKEN=

# Admin login for Sunny-only console.
# Do not commit real credentials. Use a long random ADMIN_SESSION_SECRET.
# Start with one owner account; later replace ADMIN_LOGIN_* with ADMIN_USERS_JSON
# for multiple Sunny member accounts.
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_NAME=Sunny Owner
ADMIN_LOGIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Example only:
# ADMIN_USERS_JSON=[{"username":"john","name":"John","password":"use-a-long-private-password","role":"owner"},{"username":"team","name":"Sunny Team","password":"use-a-different-password","role":"member"}]

# HTTP security
# Comma-separated browser origins allowed to call the API.
# Leave empty only for same-origin/server-to-server deployments.
CORS_ALLOWED_ORIGINS=https://sunnykr.com,https://www.sunnykr.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# SunnyKR.com project files
# Keep confidential files out of the public website build.
SUNNYKR_PROJECT_FILES_ROOT=C:\Users\admin\Documents\New project\SunnyKR_Project_Files
SUNNYKR_RFQ_PO_EMAIL_SAMPLES_DIR=C:\Users\admin\Documents\New project\SunnyKR_Project_Files\07_RFQ_PO_Email_Samples
SUNNYKR_ORDERLIST_WORKBOOK_PATH=C:\Users\admin\Documents\New project\SunnyKR_Project_Files\04_Documents_SPA_Private\orderlist 26.05.06.xlsx
SUNNYKR_SOURCING_SCHEDULE_WORKBOOK_PATH=C:\Users\admin\Documents\New project\SunnyKR_Project_Files\04_Documents_SPA_Private\sourcing schedule 26.05.06.xlsx

# Outlook / Microsoft 365 intake
# Use OAuth/service configuration. Do not commit real credentials.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_MAILBOX_ADDRESS=john@sunny.co.kr

# IMAP/SMTP fallback intake
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=john@sunny.co.kr
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=john@sunny.co.kr
SMTP_PASSWORD=

# PST historical import
PST_PRIMARY_PATH=C:\Users\admin\Documents\Outlook Files\john@sunny.co.kr - SunnyJohn_backup.pst.pst
PST_ARCHIVE_PATH=C:\Users\admin\Documents\Outlook Files\Archive_REAL_2016_2025.pst.pst

# Gmail optional later
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_WATCH_LABEL=INBOX

# AI classification
OPENAI_API_KEY=
EMAIL_AI_MODEL=

# Sunny website AI bridge
# Keep real bridge URLs/tokens in Vercel/local env only.
SUNNY_AI_BRIDGE_URL=
SUNNY_AI_BRIDGE_TOKEN=
SUNNY_AI_TIMEOUT_MS=5500
AI_BRIDGE_URL=
AI_BRIDGE_TOKEN=
OPENCLAW_URL=
OPENCLAW_API_KEY=
